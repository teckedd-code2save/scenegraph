{
  "name": "scenegraph",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @scenegraph/studio --filter @scenegraph/director --filter @scenegraph/render-worker dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "engines": {
    "node": ">=22"
  }
}
