{
  "manifest_version": 3,
  "name": "SceneGraph Capture",
  "version": "0.1.0",
  "description": "Captures clean product pixels and precise interaction anchors.",
  "permissions": ["activeTab", "scripting", "storage", "tabCapture", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "dist/background.js", "type": "module"},
  "action": {"default_title": "Start SceneGraph capture"},
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["dist/content.js"],
    "run_at": "document_start"
  }]
}
