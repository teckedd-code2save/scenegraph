# Public HTTPS URL assigned to the gateway in GroundControl.
SCENEGRAPH_PUBLIC_URL=https://scenegraph.serendepify.com

# Generate with: openssl rand -hex 32
SCENEGRAPH_ACCESS_TOKEN=replace-with-a-strong-random-token

# Host port used before a domain is attached. Only the gateway is exposed.
SCENEGRAPH_PORT=8080

# Production media storage. Create a private Cloudflare R2 bucket and scoped API key.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=scenegraph-media
# Optional override; normally derived from R2_ACCOUNT_ID.
# R2_ENDPOINT=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com

# Production remote renderer. MODAL_RENDER_TOKEN must match the
# SCENEGRAPH_RENDER_TOKEN stored in the Modal secret named scenegraph-renderer.
MODAL_RENDER_URL=https://replace-with-modal-endpoint.modal.run
MODAL_RENDER_TOKEN=replace-with-modal-render-token

# Image tag consumed by the GroundControl Compose deployment.
SCENEGRAPH_IMAGE_TAG=main
